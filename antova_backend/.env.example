# Antova Environment Configuration
ANTOVA_LOCATE_PROVIDER=explabs
# A long random secret, e.g. `openssl rand -hex 32`. Never reuse it across environments.
ANTOVA_REVIEW_TOKEN=
ANTOVA_TENDERS_DIR=./backend/samples
ANTOVA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PORT=8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Workbench built-in engine (frontend, when BACKEND_URL is unset). See docs/built-in-engine.md.
# LLM_API_KEY=
# LLM_MODEL_NAME=
# LLM_BASE_URL=https://api.openai.com/v1
# REVIEW_TOKEN=

